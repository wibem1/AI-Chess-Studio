/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self'; connect-src 'self' https://api.openai.com https://openrouter.ai; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/engine/stockfish-19.0.1/*.wasm
  Content-Type: application/wasm
