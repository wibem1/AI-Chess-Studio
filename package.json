{
  "name": "ai-chess-studio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc && vite build --outDir web-dist",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "tsc --noEmit",
    "dev": "vite --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:all": "npm run check && npm test && npm run test:e2e"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "stockfish": "19.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
