{
  "name": "ai-chess-studio",
  "version": "0.11.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc && vite build --outDir web-dist",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "tsc --noEmit",
    "dev": "vite --host 127.0.0.1",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run check && npm test && npm run build:pages && playwright test",
    "start": "node dist/server/start.js",
    "build:pages": "tsc && vite build --base=/AI-Chess-Studio/ --outDir pages-dist",
    "publish:pages": "npm run test:all && node scripts/publish-pages.mjs && npm run check:pages",
    "check:pages": "tsc && node scripts/pages-status.mjs --wait"
  },
  "dependencies": {
    "@indiefoundry/maia2-onnx": "0.1.0",
    "chess.js": "1.4.0",
    "onnxruntime-web": "1.31.1",
    "stockfish": "19.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
